# Database: PostgreSQL (Neon Serverless Postgres / Supabase / Cloud)
# Lấy chuỗi kết nối từ https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Telegram Bot
TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token"
TELEGRAM_CHAT_ID="replace-with-telegram-chat-id"

# AI
GEMINI_API_KEY="replace-with-gemini-api-key"

# Meta Ads Mode: MOCK hoặc REAL
META_API_MODE="MOCK"
META_AD_ACCOUNT_ID="act_123456789"
META_ACCESS_TOKEN="EAA..."
META_APP_ID="replace-with-meta-app-id"
META_APP_SECRET="replace-with-meta-app-secret"
META_GRAPH_VERSION="v21.0"
META_OAUTH_PROFILE_SCOPES="public_profile,user_posts,user_photos"
SESSION_SECRET="replace-with-a-long-random-session-secret"
META_OAUTH_CONFIG_ID="replace-with-facebook-login-for-business-config-id"

# Đường dẫn URL callback (phải khớp 100% với cấu hình trên Meta)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
META_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
