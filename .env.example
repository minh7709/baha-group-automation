# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BAHA ADS SYSTEM
# ==========================================

# 1. TELEGRAM BOT (BẮT BUỘC KẾT QUẢ THẬT THEO ĐỀ BÀI)
# Lấy Bot Token từ @BotFather:
TELEGRAM_BOT_TOKEN="7123456789:AAFxAbcDeFgHiJkLmNoPqRsTuVwXyZ"
# Lấy Chat ID từ @userinfobot:
TELEGRAM_CHAT_ID="123456789"

# 2. GOOGLE GEMINI AI (GỢI Ý NỘI DUNG QUẢNG CÁO & TARGET)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere..."

# 3. META MARKETING API (FACEBOOK ADS GRAPH API)
# Chế độ: 'MOCK' (mô phỏng an toàn không tốn tiền) hoặc 'REAL' (gọi Meta Graph API thật)
META_API_MODE="MOCK"
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="act_1234567890"

# 4. META OAUTH 2.0 MULTI-TENANT (CHO NGƯỜI DÙNG BÊN NGOÀI LIÊN KẾT FANPAGE)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
META_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# 5. CẤU HÌNH FANPAGE MẶC ĐỊNH (TÙY CHỌN NẾU DÙNG TOKEN CỐ ĐỊNH)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""

# 6. DATABASE URL (TÙY CHỌN KHI DEPLOY CLOUD SUPABASE/NEON)
DATABASE_URL="file:./prisma/dev.db"
