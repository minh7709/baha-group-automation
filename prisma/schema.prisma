datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  name              String
  role              String          @default("USER") // USER | FOUNDER | ADMIN
  emailVerified     Boolean         @default(false)
  verificationToken String?
  tokenExpiry       DateTime?
  facebookId        String?       @unique
  facebookAccessToken String?
  campaigns         Campaign[]
  connectedPages    ConnectedPage[] // 1 user sở hữu nhiều Fanpage (Multi-tenant OAuth)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ConnectedPage {
  id               String   @id @default(cuid())
  pageId           String   // Facebook Page ID (duy nhất từ Meta)
  pageName         String   // Tên Fanpage
  pageCategory     String?  // Danh mục trang
  pageAccessToken  String   // Page Token vĩnh viễn dùng để đăng bài
  instagramId      String?  // Instagram Business ID (nếu có liên kết)
  
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, pageId]) // Đảm bảo 1 user không lưu trùng 1 page 2 lần
}

model FacebookPost {
  id           String        @id @default(cuid())
  postId       String
  pageId       String
  pageName     String
  message      String        @default("")
  createdTime  DateTime
  permalinkUrl String?
  fullPicture  String?
  statusType   String?
  comments     Int           @default(0)
  reactions    Int           @default(0)
  shares       Int           @default(0)
  isMock       Boolean       @default(false)
  syncedAt     DateTime      @default(now())

  @@unique([pageId, postId])
  @@index([pageId, createdTime])
}

model Campaign {
  id                String     @id @default(cuid())
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  code              String     @unique // BaHa-ADS-YYYYMMDD-HHMMSS-XXXX
  name              String
  description       String?
  imageUrl          String?
  
  // Bước 2: Mục tiêu
  objective         String     // MESSAGES | LEAD | TRAFFIC | AWARENESS
  objectiveText     String
  specialCategory   String     @default("NONE") // NONE | HOUSING | CREDIT | EMPLOYMENT

  // Bước 3: Khách hàng & Vị trí
  location          String
  radiusKm          Int        @default(15)
  targetAge         String     @default("25 - 45")
  targetGender      String     @default("FEMALE")
  targetInterests   String?    // Lưu JSON danh sách sở thích

  // Bước 4: Ngân sách & Thời gian
  dailyBudget       Float      @default(200000)
  durationDays      Int        @default(7)
  totalBudget       Float      @default(1400000)
  maxEstimatedSpend Float      @default(1750000)
  startDate         DateTime
  endDate           DateTime

  // Bước 5: Nội dung sáng tạo
  headline          String
  primaryText       String
  callToAction      String     @default("SEND_MESSAGE")
  pageName          String     @default("Diệu BaHa - Quản Trị Thực Chiến")

  // Bước 7: Phê duyệt & An toàn
  status            String     @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED_INTERNAL, CREATED_PAUSED, ACTIVE, STOPPED, INTEGRATION_ERROR
  version           Int        @default(1)
  approvalCode      String?    // BH-APR-YYYYMMDD-XXXX
  fingerprint       String?    // a651ab1de86479ab
  approvedBy        String?
  approvedAt        DateTime?

  // Bước 8: Meta & Telegram
  metaCampaignId    String?
  metaAdSetId       String?
  metaCreativeId    String?
  metaAdId          String?
  isMock            Boolean    @default(true)
  telegramSent      Boolean    @default(false)
  telegramSentAt    DateTime?

  // Theo dõi lỗi tích hợp Meta
  lastError         String?
  errorStep         String?

  auditLogs         AuditLog[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  action     String   // CREATED, APPROVED, META_CREATED, STOPPED, PILOT_ACTIVATED
  details    String
  timestamp  DateTime @default(now())
}
